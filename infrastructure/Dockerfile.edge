# NCTIRS Edge Node — YOLOv8 Computer Vision
# Optimized for Raspberry Pi 4 / ARM64

FROM python:3.11-slim

# Install system dependencies for OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY infrastructure/edge/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Download YOLOv8n model (smallest, fastest)
RUN python -c "from ultralytics import YOLO; YOLO('yolov8n.pt')" || true

# Copy edge detector script
COPY infrastructure/edge/edge_detector.py .

# Environment configuration
ENV NCTIRS_SERVER=http://nctirs-core:3000 \
    CAMERA_ID=0 \
    CONFIDENCE=0.5 \
    INTERVAL=2 \
    DEVICE_MODE=edge

HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8081/health')" || exit 1

CMD ["python", "edge_detector.py", \
     "--server", "${NCTIRS_SERVER}", \
     "--camera", "${CAMERA_ID}", \
     "--confidence", "${CONFIDENCE}", \
     "--interval", "${INTERVAL}"]
