# =============================================================================
# NCTIRS Platform — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# On Render, set these in Dashboard → Environment tab.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (e.g., Neon, Supabase, Render Postgres)
DATABASE_URL=postgresql://user:password@host:5432/nctirs

# ── Authentication ───────────────────────────────────────────────────────────
# Secret for NextAuth.js session encryption
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical URL of your deployment
# Local: http://localhost:3000
# Render: https://your-app.onrender.com
NEXTAUTH_URL=http://localhost:3000

# ── Optional: Deployment Lock ────────────────────────────────────────────────
# Set a password to restrict access via HTTP Basic Auth
# DEPLOYMENT_PASSWORD=

# ── Optional: FCIR Integration ───────────────────────────────────────────────
# Citizen reporting platform API endpoint
# NEXT_PUBLIC_FCIR_API_URL=https://fcir-interface.vercel.app

# ── Optional: AI Providers ───────────────────────────────────────────────────
# GOOGLE_GENERATIVE_AI_KEY=
# ANTHROPIC_API_KEY=
