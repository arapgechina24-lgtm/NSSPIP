generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}



// NextAuth Models

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  encryptedDetails String? // Encrypted PII (Phone, Home Address, etc.)

  password      String?
  role          String  @default("L1")
  agency        String?
  department    String?
  clearanceLevel Int?     @default(1)
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  incidents     Incident[] @relation("UserIncidents")
  intelligence  Intelligence[]
  auditLogs     AuditLog[]
}



model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?


  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application Models

model Incident {
  id          String         @id @default(cuid())
  title       String
  description String
  type        String         @default("GENERAL")
  status      String @default("ACTIVE")
  severity    String @default("MEDIUM")
  location    String?
  // Geospatial Data: Stored as floats for Prisma compatibility, indexed in DB for PostGIS
  latitude    Float?
  longitude   Float?
  county      String?
  targetAsset String?
  attackVector String?
  indicators  String?
  dataProtectionImpact String?
  mitreAttackId String?
  
  // Zero PII: All sensitive details must be encrypted before storage
  encryptedDetails String? // JSON string of encrypted fields

  
  // Forensic-Grade Audit Trail
  forensicHash     String? // SHA-256 fingerprint for data integrity
  
  // Explainable AI (XAI)
  aiScore          Int?    // Persisted AI Risk Score
  aiFactors        String? // JSON string of contributing factors

  
  createdById String?
  createdBy   User?          @relation("UserIncidents", fields: [createdById], references: [id])
  threats     Threat[]
  responses   Response[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}



model Intelligence {
  id          String   @id @default(cuid())
  title       String
  content     String
  source      String
  classification String @default("CONFIDENTIAL")
  createdBy   String 
  author      User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
}



model Threat {
  id           String   @id @default(cuid())
  name         String
  type         String
  severity     String @default("MEDIUM")
  source       String?
  targetSector String?
  confidence   Float?
  mitreId      String?
  description  String?
  indicators   String?

  affectedCitizens Int?
  dpaViolation String?
  incidentId   String?
  incident     Incident? @relation(fields: [incidentId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SurveillanceFeed {
  id        String   @id @default(cuid())
  location  String
  type      String
  status    String   @default("ACTIVE")
  latitude  Float
  longitude Float
  streamUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Response {
  id          String   @id @default(cuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id])
  action      String
  status      String
  details     String?
  result      String?

  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  resource    String
  resourceId  String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  details     String?
  ipAddress   String?
  userAgent   String?
  hash        String?  @unique
  previousHash String?
  createdAt   DateTime @default(now())
}
